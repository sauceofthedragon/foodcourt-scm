# デモ用Supabaseプロジェクトの接続情報テンプレート。
# 実値を記入したら「.env.demo」という別名で保存すること（.env.demoはgitignore対象）。
# 切替方法はREADME.md「デモ環境への切替」セクションを参照。

ADMIN_PASSWORD=demo-password-here
AUTH_SECRET=demo-auth-secret-here
ADMIN_EMAIL=demo@example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-demo-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-demo-anon-key-here
